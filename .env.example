# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (Project URL and the anon / publishable key).
# Leave them empty to run without a database (data stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Goong.io API key for address suggestions (server only; set it in Vercel too). Optional daily cap per server instance.
GOONG_API_KEY=
# GOONG_DAILY_MAX=300

# Bank transfer QR + SePay (see lib/pay.ts). Account and bank are public (they are printed in the QR); use the bank
# short name from https://qr.sepay.vn/banks.json, e.g. MBBank, Vietcombank. The webhook key is NOT set here: it lives
# only in SePay and in the database table app_secrets (supabase/schema.sql).
NEXT_PUBLIC_BANK_ACC=
NEXT_PUBLIC_BANK_NAME=
